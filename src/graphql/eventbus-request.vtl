{
  "version": "2018-05-29",
  "method": "POST",
  "resourcePath": "/",
  "params": {
    "headers": {
      "content-type": "application/x-amz-json-1.1",
      "x-amz-target": "AWSEvents.PutEvents"
    },
    "body": $util.toJson({
      "Entries": [
        {
          "Source": "$ctx.args.source",
          "DetailType": "$ctx.args.detailType",
          "Detail": "$util.toJson($ctx.args.detail)",
          "EventBusName": "$ctx.args.eventBus"
        }
      ]
    })
  }
}